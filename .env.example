# =============================================================================
# PBLMS — Environment Variable Template
# Pharmaceutical Bin Lifecycle Management System
# =============================================================================
#
# INSTRUCTIONS:
#  1. Copy this file to .env in the relevant directory (root or server/)
#  2. Replace all placeholder values with actual configuration
#  3. Never commit .env files to version control
#  4. Generate strong random secrets for JWT keys (minimum 256 bits of entropy)
#  5. Rotate secrets on credential compromise, security audit, or annually
#
# =============================================================================

# --- Node.js / Express Server ---
PORT=3000
NODE_ENV=development

# --- Frontend (Vite) ---
# The base URL for API calls from the React frontend.
# In development, use /api (proxied via Vite to the backend).
# In production, use the full origin.
VITE_API_BASE_URL=/api

# --- CORS ---
# Allowed frontend origins for CORS. Comma-separated for multiple origins.
# Must be the exact URL of the React app. No wildcard (*) permitted.
# Examples:
#   Single origin:  ALLOWED_ORIGIN=http://localhost:5173
#   Multiple:       ALLOWED_ORIGIN=http://localhost:5173,http://192.168.1.100:5173
ALLOWED_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
# Rate limit window in milliseconds (default: 15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per authenticated user IP (default: 200)
RATE_LIMIT_MAX=200

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pblms
DB_USER=pblms_app
DB_PASSWORD=replace_with_secure_db_password
# Maximum connections in the mysql2 connection pool
DB_POOL_LIMIT=20
# Maximum queued connection requests when pool is exhausted
DB_QUEUE_LIMIT=50

# --- Test Database (Phase 12, used by Jest test suites) ---
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=pblms_test
TEST_DB_USER=pblms_test
TEST_DB_PASSWORD=replace_with_secure_test_db_password

# --- JWT Authentication ---
# Access token secret — minimum 256 bits. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_256bit_random_secret
# Refresh token secret — must differ from access token secret. Generate separately.
JWT_REFRESH_SECRET=replace_with_256bit_random_secret
# Access token expiry (default: 8 hours)
JWT_ACCESS_EXPIRY=8h
# Refresh token expiry (default: 24 hours)
JWT_REFRESH_EXPIRY=24h

# --- Logging ---
# Log level: debug (development), info (production), warn, error
LOG_LEVEL=debug
# Log directory path (relative to server/)
LOG_DIR=logs